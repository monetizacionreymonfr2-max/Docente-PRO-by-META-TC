rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
       return request.auth != null;
    }
    
    function isOwner(userId) {
       return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "monetizacionreymonfr2@gmail.com";
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidCode(data) {
      return data.keys().hasAll(['status', 'access_level', 'createdAt']) &&
             data.status in ['disponible', 'usado'] &&
             data.access_level in ['guest', 'pro'];
    }

    // Check ownership for any document that has a 'docenteId' or 'uid' field
    function isDocOwner() {
      return isSignedIn() && (
        (resource != null && (
          resource.data.docenteId == request.auth.uid || 
          resource.data.teacher_id == request.auth.uid || 
          resource.data.uid == request.auth.uid
        )) ||
        (request.resource != null && (
          request.resource.data.docenteId == request.auth.uid || 
          request.resource.data.teacher_id == request.auth.uid || 
          request.resource.data.uid == request.auth.uid
        ))
      );
    }

    // Check if user is within the 3-generation limit if they are a Guest
    function isWithinGuestLimit() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAdmin() || profile.access_level != 'guest' || (profile.generationsCount < 3);
    }

    // ===============================================================
    // Rules by Collection
    // ===============================================================

    // User Profiles
    match /users/{userId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
    }

    // Activation Codes
    match /activation_codes/{codeId} {
      allow read, write: if request.auth.token.email == "monetizacionreymonfr2@gmail.com";
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow update: if isSignedIn() && 
                      existing().status == 'disponible' && 
                      incoming().status == 'usado' &&
                      incoming().usedBy == request.auth.uid &&
                      incoming().usedByEmail == request.auth.token.email &&
                      incoming().expiresAt is timestamp &&
                      incoming().usedAt == request.time &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['status', 'usedBy', 'usedByEmail', 'usedAt', 'expiresAt']);
    }

    // App Data Collections
    
    // Students list
    match /estudiantes/{document} {
      allow read, write: if isAdmin() || isDocOwner();
    }

    // Attendance records
    match /asistencias/{document} {
      allow read, write: if isAdmin() || isDocOwner();
    }

    // PPA Projects (Projects, Objectives, etc.)
    match /proyectos_ppa/{document} {
      allow read: if isAdmin() || isDocOwner();
      allow create: if (isAdmin() || isDocOwner()) && isWithinGuestLimit();
      allow update, delete: if isAdmin() || isDocOwner();
    }

    // Daily Lesson Plans
    match /planificaciones_diarias/{document} {
      allow read: if isAdmin() || isDocOwner();
      allow create: if (isAdmin() || isDocOwner()) && isWithinGuestLimit();
      allow update, delete: if isAdmin() || isDocOwner();
    }

    // Evaluation Reports / Boletines
    match /boletines/{document} {
      allow read: if isAdmin() || isDocOwner();
      allow create: if (isAdmin() || isDocOwner()) && isWithinGuestLimit();
      allow update, delete: if isAdmin() || isDocOwner();
    }

    // Maternal Routines and Milestones
    match /bitacoras_maternal/{document} {
      allow read, write: if isAdmin() || isDocOwner();
    }

    match /activation_codes_admin/{document} {
      allow read, write: if isAdmin();
    }
  }
}
