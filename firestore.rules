rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
       return request.auth != null;
    }
    
    function isOwner(userId) {
       return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isBanned() {
      return isSignedIn() && 
             request.auth.token.email != null && 
             exists(/databases/$(database)/documents/blacklist/$(request.auth.token.email.lower()));
    }

    function isAdmin() {
      return isSignedIn() && !isBanned() && (request.auth.token.email.lower() == "tecnomundo235@gmail.com" || request.auth.token.email.lower() == "monetizacionreymonfr2@gmail.com");
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-+@\\.]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidCode(data) {
      return data.keys().hasAll(['status', 'access_level', 'createdAt']) &&
             data.status in ['disponible', 'usado'] &&
             data.access_level in ['guest', 'pro'];
    }

    function isActiveUser() {
      return isSignedIn() && !isBanned() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true &&
          (
            !('expiresAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.expiresAt > request.time
          )
        )
      );
    }

    // Parametrized check to ensure ownership for any document
    function isDocOwner(data) {
      return isActiveUser() && (
        ('docenteId' in data && data.docenteId == request.auth.uid) || 
        ('teacher_id' in data && data.teacher_id == request.auth.uid) || 
        ('uid' in data && data.uid == request.auth.uid)
      );
    }

    // Check if user is within the 3-generation limit if they are a Guest
    function isWithinGuestLimit() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAdmin() || profile.access_level != 'guest' || (profile.generationsCount < 3);
    }

    // ===============================================================
    // Rules by Collection
    // ===============================================================

    // User Profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || (isSignedIn() && request.auth.token.email.lower() == userId.lower());
      allow create: if isAdmin() || (
                      isOwner(userId) && 
                      incoming().email.lower() == request.auth.token.email.lower() &&
                      (
                        (incoming().email.lower() in ["tecnomundo235@gmail.com", "monetizacionreymonfr2@gmail.com"] && incoming().role == "admin" && incoming().isActive == true) ||
                        (!(incoming().email.lower() in ["tecnomundo235@gmail.com", "monetizacionreymonfr2@gmail.com"]) && incoming().role == "teacher" && incoming().generationsCount == 0 && (
                          incoming().isActive == false || 
                          exists(/databases/$(database)/documents/users/$(incoming().email.lower()))
                        ))
                      )
                    );
      allow update: if isAdmin() || (
        isOwner(userId) && (
          // Case 1: Simple increment of generations
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['generationsCount']) &&
            incoming().generationsCount == existing().generationsCount + 1
          ) ||
          // Case 2: Code Activation verified against code doc in database
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['isActive', 'access_level', 'expiresAt', 'activatedAt', 'activationCode']) &&
            incoming().role == existing().role && // Cannot change role
            incoming().isActive == true &&
            'activationCode' in incoming() &&
            incoming().activationCode is string &&
            exists(/databases/$(database)/documents/activation_codes/$(incoming().activationCode)) &&
            (
              get(/databases/$(database)/documents/activation_codes/$(incoming().activationCode)).data.status == 'disponible' ||
              get(/databases/$(database)/documents/activation_codes/$(incoming().activationCode)).data.usedBy == request.auth.uid
            )
          )
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && request.auth.token.email.lower() == userId.lower());
    }

    // Activation Codes
    match /activation_codes/{codeId} {
      allow read, write: if request.auth.token.email.lower() == "tecnomundo235@gmail.com" || request.auth.token.email.lower() == "monetizacionreymonfr2@gmail.com";
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow update: if isSignedIn() && 
                      existing().status == 'disponible' && 
                      incoming().status == 'usado' &&
                      incoming().usedBy == request.auth.uid &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['status', 'usedBy', 'usedByEmail', 'usedAt', 'expiresAt']);
    }

    // App Data Collections
    
    // Students list
    match /estudiantes/{document} {
      allow read: if isAdmin() || (resource != null && isDocOwner(existing()));
      allow create: if isAdmin() || isDocOwner(incoming());
      allow update: if isAdmin() || (resource != null && isDocOwner(existing()) && isDocOwner(incoming()));
      allow delete: if isAdmin() || (resource != null && isDocOwner(existing()));
    }

    // Attendance records
    match /asistencias/{document} {
      allow read: if isAdmin() || (resource != null && isDocOwner(existing()));
      allow create: if isAdmin() || isDocOwner(incoming());
      allow update: if isAdmin() || (resource != null && isDocOwner(existing()) && isDocOwner(incoming()));
      allow delete: if isAdmin() || (resource != null && isDocOwner(existing()));
    }

    // PPA Projects (Projects, Objectives, etc.)
    match /proyectos_ppa/{document} {
      allow read: if isAdmin() || (resource != null && isDocOwner(existing()));
      allow create: if (isAdmin() || isDocOwner(incoming())) && isWithinGuestLimit();
      allow update: if isAdmin() || (resource != null && isDocOwner(existing()) && isDocOwner(incoming()));
      allow delete: if isAdmin() || (resource != null && isDocOwner(existing()));
    }

    // Daily Lesson Plans
    match /planificaciones_diarias/{document} {
      allow read: if isAdmin() || (resource != null && isDocOwner(existing()));
      allow create: if (isAdmin() || isDocOwner(incoming())) && isWithinGuestLimit();
      allow update: if isAdmin() || (resource != null && isDocOwner(existing()) && isDocOwner(incoming()));
      allow delete: if isAdmin() || (resource != null && isDocOwner(existing()));
    }

    // Evaluation Reports / Boletines
    match /boletines/{document} {
      allow read: if isAdmin() || (resource != null && isDocOwner(existing()));
      allow create: if (isAdmin() || isDocOwner(incoming())) && isWithinGuestLimit();
      allow update: if isAdmin() || (resource != null && isDocOwner(existing()) && isDocOwner(incoming()));
      allow delete: if isAdmin() || (resource != null && isDocOwner(existing()));
    }

    // Maternal Routines and Milestones
    match /bitacoras_maternal/{document} {
      allow read: if isAdmin() || (resource != null && isDocOwner(existing()));
      allow create: if isAdmin() || isDocOwner(incoming());
      allow update: if isAdmin() || (resource != null && isDocOwner(existing()) && isDocOwner(incoming()));
      allow delete: if isAdmin() || (resource != null && isDocOwner(existing()));
    }

    match /activation_codes_admin/{document} {
      allow read, write: if isAdmin();
    }

    match /blacklist/{emailId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.token.email == emailId);
      allow write: if isAdmin();
    }
  }
}
