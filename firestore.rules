rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
       return request.auth != null;
    }
    
    function isOwner(userId) {
       return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             (request.auth.token.email == "monetizacionreymonfr2@gmail.com" || 
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }
    
    // Check ownership for any document that has a 'docenteId' or 'uid' field
    function isDocOwner() {
      return isAuthenticated() && (
        (resource != null && (
          resource.data.docenteId == request.auth.uid || 
          resource.data.uid == request.auth.uid
        )) ||
        (request.resource != null && (
          request.resource.data.docenteId == request.auth.uid || 
          request.resource.data.uid == request.auth.uid
        ))
      );
    }

    // ===============================================================
    // Rules by Collection
    // ===============================================================

    // User Profiles
    match /users/{userId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
    }

    // Activation Codes
    match /activation_codes/{codeId} {
      allow get: if isAuthenticated();
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (
                      isAuthenticated() && 
                      resource.data.status == 'disponible' && 
                      request.resource.data.status == 'usado' &&
                      request.resource.data.usedBy == request.auth.uid
                    );
    }

    // App Data Collections
    // Using a more flexible matching to ensure all docente-owned data is covered
    
    // Students list
    match /estudiantes/{document} {
      allow read, write: if isAdmin() || isDocOwner();
    }

    // Attendance records
    match /asistencias/{document} {
      allow read, write: if isAdmin() || isDocOwner();
    }

    // PPA Projects (Projects, Objectives, etc.)
    match /proyectos_ppa/{document} {
      allow read, write: if isAdmin() || isDocOwner();
    }

    // Daily Lesson Plans
    match /planificaciones_diarias/{document} {
      allow read, write: if isAdmin() || isDocOwner();
    }

    // Evaluation Reports / Boletines
    match /boletines/{document} {
      allow read, write: if isAdmin() || isDocOwner();
    }

    // Maternal Routines and Milestones
    match /bitacoras_maternal/{document} {
      allow read, write: if isAdmin() || isDocOwner();
    }

    // Codes Management (handled above but repeated for safety)
    match /activation_codes/{document} {
      allow read, write: if isAdmin();
    }
    
    match /activation_codes_admin/{document} {
      allow read, write: if isAdmin();
    }
  }
}
